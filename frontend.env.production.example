# Frontend env для production (Vite build-time)
# Исходники frontend в корне репозитория (не в подпапке frontend/).
# В Docker эти значения задаются через build args в docker-compose.production.yml.
#
# Локальная проверка production build:
#   cp frontend.env.production.example .env.production.local
#   npm run build && npm run preview

VITE_API_URL=/api
VITE_FORMILY_RUNTIME=true

# AI / assistant UI (disabled in production by default)
VITE_ENABLE_REQUEST_ASSISTANT=false
VITE_ENABLE_EXECUTOR_MATCHING=false
VITE_ENABLE_TZ_GENERATION=false