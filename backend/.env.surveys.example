# Values for docker-compose.production.yml. Keep this file as a template only.
SECRET_KEY=replace-with-a-random-48-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["https://surveys.svodservice.ru"]

# A private S3-compatible bucket. S3_PUBLIC_ENDPOINT_URL must be reachable by
# the user's browser because the backend returns short-lived signed URLs.
FILE_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://your-s3-endpoint.example
S3_PUBLIC_ENDPOINT_URL=https://your-s3-endpoint.example
S3_REGION=us-east-1
S3_BUCKET=svod-private
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_PRESIGNED_URL_SECONDS=900
MAX_UPLOAD_SIZE_BYTES=20971520

AI_JOBS_ENABLED=true
AI_WORKER_POLL_SECONDS=2
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_STALE_SECONDS=900
WORKER_METRICS_PORT=9101

OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_REASONING_EFFORT=low
# Links in invitation emails point here
APP_PUBLIC_URL=https://surveys.svodservice.ru
SURVEYS_APP_PUBLIC_URL=https://surveys.svodservice.ru
INVITATION_TTL_DAYS=7
# Outgoing mail for invitations (empty SMTP_HOST = owner copies the link manually)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=no-reply@servicedev.space
SMTP_PASSWORD=replace-with-app-password
SMTP_FROM=no-reply@servicedev.space
DADATA_API_KEY=
YANDEX_MAPS_API_KEY=
# Telegram bot (container telegram-bot, python -m app.telegram_bot). Token from @BotFather.
# Empty TELEGRAM_BOT_TOKEN disables the integration; the web UI then shows "бот не настроен".
TELEGRAM_BOT_TOKEN=
# Bot username without "@", used for t.me deep links
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_TOKEN_TTL_MINUTES=10
TELEGRAM_POLL_SECONDS=3
TELEGRAM_NOTIFICATION_MAX_AGE_HOURS=24
# Groups: analyze the dialog after N new messages and M seconds of silence
TELEGRAM_ANALYSIS_MIN_MESSAGES=3
TELEGRAM_ANALYSIS_IDLE_SECONDS=180
# Group messages are kept this many days; unconfirmed drafts expire after TTL hours
TELEGRAM_MESSAGE_RETENTION_DAYS=7
TELEGRAM_SUGGESTION_TTL_HOURS=24
