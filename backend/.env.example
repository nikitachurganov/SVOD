# Use localhost when running Alembic or uvicorn on your machine (not inside Docker).
# Hostname "db" only works inside Docker Compose — it will fail with getaddrinfo on Windows/macOS hosts.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/myapp
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# JSON list. Add your Vite dev origin or the browser gets 400 on OPTIONS (CORS preflight).
# Production: ["https://app.svodservice.ru"] — see backend/.env.production.example
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
FILE_STORAGE_BACKEND=local
FILE_STORAGE_BASE_URL=http://localhost:8000/uploads
GIGACHAT_AUTH_KEY=your-base64-encoded-credentials
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Optional: DaData token for address suggestions proxy (GET /suggest/address)
DADATA_API_KEY=
# API-ключ Яндекс Карт / Геосаджест (для GET /suggest/yandex)
YANDEX_MAPS_API_KEY=
