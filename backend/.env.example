# Use localhost when running Alembic or uvicorn on your machine (not inside Docker).
# Hostname "db" only works inside Docker Compose — it will fail with getaddrinfo on Windows/macOS hosts.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/myapp
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# JSON list. Add your Vite dev origin or the browser gets 400 on OPTIONS (CORS preflight).
# Production: ["https://app.svodservice.ru"] — see backend/.env.production.example
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
FILE_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=svod-private
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-secret
S3_PRESIGNED_URL_SECONDS=900
MAX_UPLOAD_SIZE_BYTES=20971520
AI_JOBS_ENABLED=true
AI_WORKER_POLL_SECONDS=2
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_STALE_SECONDS=900
WORKER_METRICS_PORT=9101
# Create a key at https://openrouter.ai/keys. Keep it server-side only.
OPENROUTER_API_KEY=your-openrouter-api-key
# See https://openrouter.ai/models for the current catalog and pricing.
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# Reasoning effort: minimal|low|medium|high (empty = provider default). "low" keeps JSON answers fast.
OPENROUTER_REASONING_EFFORT=low
# Plans and usage counting. Off: nobody is limited. On with BILLING_ENFORCE=false: counted, not blocked.
BILLING_ENABLED=false
BILLING_ENFORCE=false
BILLING_PAST_DUE_GRACE_DAYS=3
# Free trial of the paid plan, in days (once per person)
BILLING_TRIAL_DAYS=14
# How often the worker expires subscriptions, sends reminders and deletes scheduled accounts
BILLING_TICK_SECONDS=300
# Where requests for a paid plan are announced by email (needs SMTP_HOST; empty = only on the admin page)
ADMIN_NOTIFY_EMAIL=
# YooKassa online payments (a self-employed shop): both values from the YooKassa cabinet, "Интеграция".
# Empty = only the request for an invoice is offered. The notifications go to
# https://<surveys host>/api/billing/webhooks/yookassa (events payment.succeeded, payment.canceled, refund.succeeded)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Where the person returns after paying (empty = the subscription tab of the surveys service)
YOOKASSA_RETURN_URL=
# Accept notifications only from YooKassa's addresses (each one is re-checked through the API anyway)
YOOKASSA_VERIFY_WEBHOOK_IP=true
# Lets the worker warn before the OpenRouter credit runs out: a MANAGEMENT key from the OpenRouter cabinet
# (not the usual key). Empty = the balance is not watched.
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_LOW_BALANCE_USD=5
# The same operational alert (AI failing, spending cap, credit, payments) is mailed again no sooner than this
OPS_ALERT_COOLDOWN_MINUTES=360
# Cap on the AI spending of the whole service per rolling 24 hours, USD (0 = no cap)
AI_DAILY_BUDGET_USD=0
# Roubles per dollar for the per-account AI budgets (with the top-up surcharge)
AI_COST_RUB_PER_USD=90
# Token prices in USD per million, used only when OpenRouter does not report the cost of a request
OPENROUTER_PRICE_IN_USD_PER_M=0.17
OPENROUTER_PRICE_OUT_USD_PER_M=0.60
# Public URL of the web app: links in emails (account activation) point here
APP_PUBLIC_URL=http://localhost:5173
INVITATION_TTL_DAYS=7
# Public URL of the standalone surveys service: password reset emails for its users point here
# (empty — APP_PUBLIC_URL). Without SMTP the reset link is written to the server log.
SURVEYS_APP_PUBLIC_URL=
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_COOLDOWN_SECONDS=60
# Confirmation of the mailbox after sign-up (the link is emailed; without SMTP it goes to the API log)
EMAIL_VERIFICATION_TTL_HOURS=48
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
# Outgoing mail (invitations). Leave SMTP_HOST empty to disable sending:
# the owner then copies the activation link from the UI.
# Yandex 360: smtp.yandex.ru, port 465, SMTP_SECURITY=ssl, app password in SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# ssl (implicit TLS, 465) | starttls (587) | none
SMTP_SECURITY=ssl
# Optional: DaData token for address suggestions proxy (GET /suggest/address)
DADATA_API_KEY=
# API-ключ Яндекс Карт / Геосаджест (для GET /suggest/yandex)
YANDEX_MAPS_API_KEY=
# Telegram bot (container telegram-bot, python -m app.telegram_bot). Token from @BotFather.
# Empty TELEGRAM_BOT_TOKEN disables the integration; the web UI then shows "бот не настроен".
TELEGRAM_BOT_TOKEN=
# Bot username without "@", used for t.me deep links
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_TOKEN_TTL_MINUTES=10
TELEGRAM_POLL_SECONDS=3
TELEGRAM_NOTIFICATION_MAX_AGE_HOURS=24
# Groups: analyze the dialog after N new messages and M seconds of silence
TELEGRAM_ANALYSIS_MIN_MESSAGES=3
TELEGRAM_ANALYSIS_IDLE_SECONDS=180
# Group messages are kept this many days; unconfirmed drafts expire after TTL hours
TELEGRAM_MESSAGE_RETENTION_DAYS=7
TELEGRAM_SUGGESTION_TTL_HOURS=24
