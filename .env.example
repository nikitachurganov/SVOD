VITE_API_URL=http://localhost:8000
VITE_FORMILY_RUNTIME=true
# Ключ Яндекс Карт задаётся на backend (backend/.env → YANDEX_MAPS_API_KEY), не здесь.

# Production (Docker / VPS): используйте относительный путь /api
# См. .env.production.example и docs/DEPLOYMENT_VPS.md
# VITE_API_URL=/api

# Feature flags (opt-out: set to false to disable). Dev: omit = enabled.
# VITE_ENABLE_REQUEST_ASSISTANT=false
# VITE_ENABLE_EXECUTOR_MATCHING=false
# VITE_ENABLE_TZ_GENERATION=false
