{
  "openapi": "3.0.3",
  "info": {
    "title": "Выкуп авто за 3 млн рублей — учебный API",
    "version": "1.0.0",
    "description": "Три новые таблицы: ad_likes, draws, draw_participants. users и ads существуют. Учебное допущение: отбор топ-10 по лайкам; при равенстве по ad_id. Номера фиксируются до публикации используемого курса. Источник, дата курса, точность и временная зона задаются правилами кампании заранее. Базовый URL указан для примера."
  },
  "servers": [
    {
      "url": "https://api.example.com/buyback/v1",
      "description": "Условный адрес"
    }
  ],
  "security": [],
  "paths": {
    "/ads/{adId}/likes": {
      "parameters": [
        {
          "name": "adId",
          "in": "path",
          "required": true,
          "description": "Идентификатор объявления",
          "schema": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      ],
      "get": {
        "operationId": "getAdLikes",
        "summary": "Получить количество лайков",
        "tags": [
          "Лайки"
        ],
        "responses": {
          "200": {
            "description": "Количество действующих лайков",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LikeCount"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "429": {
            "$ref": "#/components/responses/429"
          }
        }
      }
    },
    "/ads/{adId}/likes/me": {
      "parameters": [
        {
          "name": "adId",
          "in": "path",
          "required": true,
          "description": "Идентификатор объявления",
          "schema": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      ],
      "put": {
        "operationId": "putMyLike",
        "summary": "Поставить лайк текущего пользователя",
        "tags": [
          "Лайки"
        ],
        "security": [
          {
            "userBearer": []
          }
        ],
        "description": "Идемпотентно. user_id берётся из проверенного токена. Требуются активное подходящее объявление и действующий аккаунт. Самолайк запрещён. Повторный запрос проверяется по тем же правилам.",
        "responses": {
          "204": {
            "description": "Лайк установлен или уже существовал"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "429": {
            "$ref": "#/components/responses/429"
          }
        }
      },
      "delete": {
        "operationId": "deleteMyLike",
        "summary": "Снять лайк текущего пользователя",
        "tags": [
          "Лайки"
        ],
        "security": [
          {
            "userBearer": []
          }
        ],
        "description": "Идемпотентно. Отсутствие лайка также возвращает 204. Можно снять лайк после закрытия объявления. Чужой user_id не принимается.",
        "responses": {
          "204": {
            "description": "Собственный лайк отсутствует"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "429": {
            "$ref": "#/components/responses/429"
          }
        }
      }
    },
    "/draws": {
      "get": {
        "operationId": "listDraws",
        "summary": "Получить розыгрыши",
        "tags": [
          "Розыгрыши"
        ],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "description": "Точная дата розыгрыша в зоне кампании",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "description": "Сортировка по drawDate по убыванию. Возвращает как ожидающие результата, так и завершённые розыгрыши.",
        "responses": {
          "200": {
            "description": "Страница розыгрышей",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DrawPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "429": {
            "$ref": "#/components/responses/429"
          }
        }
      }
    },
    "/draws/{drawId}": {
      "parameters": [
        {
          "name": "drawId",
          "in": "path",
          "required": true,
          "description": "Идентификатор розыгрыша",
          "schema": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      ],
      "get": {
        "operationId": "getDraw",
        "summary": "Получить претендентов и результат розыгрыша",
        "tags": [
          "Розыгрыши"
        ],
        "responses": {
          "200": {
            "description": "Розыгрыш с 10 претендентами; result равен null до завершения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Draw"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "429": {
            "$ref": "#/components/responses/429"
          }
        }
      }
    },
    "/internal/draws/select": {
      "post": {
        "operationId": "selectDrawParticipants",
        "summary": "Создать розыгрыш и зафиксировать 10 претендентов",
        "tags": [
          "Внутренние операции"
        ],
        "security": [
          {
            "serviceBearer": []
          }
        ],
        "x-required-permissions": [
          "draws:select"
        ],
        "description": "Только технический субъект с разрешением draws:select. Проверяются рабочий день и настроенное окно отбора до публикации курса. Топ-10 и номера сохраняются атомарно из согласованного снимка. При равенстве лайков порядок по ad_id. Повтор для уже существующей даты возвращает сохранённый розыгрыш без изменения участников.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "drawDate"
                ],
                "properties": {
                  "drawDate": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Розыгрыш на эту дату уже существует",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Draw"
                }
              }
            }
          },
          "201": {
            "description": "Розыгрыш создан, 10 претендентов зафиксированы",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Draw"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "429": {
            "$ref": "#/components/responses/429"
          }
        }
      }
    },
    "/internal/draws/{drawId}/complete": {
      "parameters": [
        {
          "name": "drawId",
          "in": "path",
          "required": true,
          "description": "Идентификатор розыгрыша",
          "schema": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      ],
      "post": {
        "operationId": "completeDraw",
        "summary": "Завершить розыгрыш по курсу из настроенного источника",
        "tags": [
          "Внутренние операции"
        ],
        "security": [
          {
            "serviceBearer": []
          }
        ],
        "x-required-permissions": [
          "draws:complete"
        ],
        "description": "Только технический субъект с разрешением draws:complete. Тела запроса нет: курс и победитель не принимаются от клиента. Сервис проверяет источник, дату курса, наличие 10 участников и фиксацию номеров до публикации курса. Цифра вычисляется как (курс × 10000) mod 10 без двоичной арифметики float. Если розыгрыш уже завершён, возвращается прежний результат.",
        "responses": {
          "200": {
            "description": "Завершённый розыгрыш",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Draw"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "userBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Токен пользователя существующей площадки. sub определяет user_id."
      },
      "serviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Отдельный технический токен. Сервер проверяет тип субъекта и указанное в операции разрешение x-required-permissions. Для HTTP bearer список scopes в security остаётся пустым."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "INSUFFICIENT_CANDIDATES"
          },
          "message": {
            "type": "string",
            "example": "Для розыгрыша требуется 10 подходящих объявлений"
          }
        }
      },
      "LikeCount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adId",
          "count"
        ],
        "properties": {
          "adId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Participant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adId",
          "slotNumber",
          "likesAtSelection",
          "selectedAt"
        ],
        "properties": {
          "adId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "slotNumber": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "likesAtSelection": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "selectedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Draw": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "drawDate",
          "status",
          "participants",
          "result"
        ],
        "description": "shortlisted требует result=null; completed требует заполненный result. Номера участников уникальны и покрывают 0–9. winnerAdId соответствует участнику winningDigit. Эти межполевые правила проверяет сервер.",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "drawDate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "shortlisted",
              "completed"
            ]
          },
          "participants": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/Participant"
            }
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cnyRate",
              "rateSource",
              "rateDate",
              "winningDigit",
              "winnerAdId",
              "completedAt"
            ],
            "properties": {
              "cnyRate": {
                "type": "string",
                "pattern": "^[0-9]{1,8}\\.[0-9]{4}$",
                "example": "12.3450",
                "description": "Положительный курс RUB за 1 CNY с четырьмя десятичными знаками."
              },
              "rateSource": {
                "type": "string",
                "minLength": 1
              },
              "rateDate": {
                "type": "string",
                "format": "date"
              },
              "winningDigit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "winnerAdId": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              },
              "completedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "nullable": true
          }
        }
      },
      "DrawPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "limit",
          "offset",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Draw"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      }
    },
    "responses": {
      "400": {
        "description": "Неверный формат или значение параметров",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "Токен отсутствует, истёк или недействителен",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "403": {
        "description": "Нет разрешения, аккаунт заблокирован или запрещён самолайк",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "Объявление или розыгрыш не найдены",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "Конфликт условий: объявление не участвует в акции, нерабочий день, закрыто окно отбора, меньше 10 кандидатов, курс ещё не опубликован либо не соответствует правилам",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "429": {
        "description": "Превышен лимит запросов",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "503": {
        "description": "Настроенный источник курса временно недоступен",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}

