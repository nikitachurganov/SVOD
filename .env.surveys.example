# Compose env for docker-compose.surveys.yml: copy to .env on the server
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=surveys
VITE_FORMILY_RUNTIME=true
# surveys.svodservice.ru.http.conf until the certificate is issued, then surveys.svodservice.ru.conf
NGINX_CONF=surveys.svodservice.ru.http.conf
